{
  "name": "byeolharu-android-shell-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Android-only Capacitor shell experiment. Not a release build.",
  "scripts": {
    "check": "node scripts/check-shell.mjs && node scripts/check-native-template.mjs",
    "android:init": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:patch": "node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
