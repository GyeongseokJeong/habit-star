package __PACKAGE__;

import android.content.Intent;
import android.content.Context;
import java.lang.ref.WeakReference;
import android.app.NotificationManager;
import android.service.notification.StatusBarNotification;
import com.getcapacitor.JSArray;
import com.getcapacitor.JSObject;
import android.provider.Settings;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

/**
 * Isolated packaged-guest UX: Android may refuse to show a second runtime
 * notification permission dialog after the user blocks notifications in
 * system settings. Open this package's actual settings screen instead.
 * Never alter permissions, user intent or native pending reservations.
 */
@CapacitorPlugin(name = "ByeolharuDeviceSettings")
public class ByeolharuDeviceSettingsPlugin extends Plugin {
    private static WeakReference<ByeolharuDeviceSettingsPlugin> active = new WeakReference<>(null);
    @Override public void load() { active = new WeakReference<>(this); }
    static boolean dispatchWidgetPractice(JSObject request) {
        ByeolharuDeviceSettingsPlugin plugin = active.get();
        if (plugin == null || plugin.getActivity() == null || plugin.getActivity().isDestroyed()
            || !plugin.hasListeners("widgetPracticeRequest")) return false;
        plugin.notifyListeners("widgetPracticeRequest", request);
        return true;
    }
    @PluginMethod public void claimWidgetPractice(PluginCall call) {
        JSObject result = new JSObject();
        result.put("accepted", ByeolharuWidgetProvider.claim(getContext(), call.getData()));
        call.resolve(result);
    }
    @PluginMethod public void finishWidgetPractice(PluginCall call) {
        ByeolharuWidgetProvider.complete(getContext(), call.getString("requestId", ""), call.getString("result", "error"));
        call.resolve();
    }
    /** Widget bridge accepts only a minimal, opted-in display projection. */
    @PluginMethod
    public void publishWidgetSummary(PluginCall call) {
        try {
            ByeolharuWidgetProvider.publish(getContext(), call.getData());
            call.resolve();
        } catch (Exception e) {
            call.reject("Cannot refresh home widgets", e);
        }
    }

    /** Observe posted times only for our app's currently visible notifications. */
    @PluginMethod
    public void getActiveReminderPosts(PluginCall call) {
        try {
            NotificationManager manager = (NotificationManager) getContext().getSystemService(Context.NOTIFICATION_SERVICE);
            if (manager == null) { call.reject("Notification service unavailable"); return; }
            JSArray posts = new JSArray();
            for (StatusBarNotification item : manager.getActiveNotifications()) {
                if (item.getNotification() == null ||
                    !"byeolharu-habit-reminders-step5".equals(item.getNotification().getChannelId())) continue;
                JSObject row = new JSObject();
                row.put("id", item.getId());
                row.put("postedAt", item.getPostTime());
                posts.put(row);
            }
            JSObject result = new JSObject();
            result.put("posts", posts);
            call.resolve(result);
        } catch (Exception e) { call.reject("Cannot inspect notification times", e); }
    }
    @PluginMethod
    public void openNotificationSettings(PluginCall call) {
        try {
            Intent intent = new Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS);
            intent.putExtra(Settings.EXTRA_APP_PACKAGE, getContext().getPackageName());
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            getContext().startActivity(intent);
            call.resolve();
        } catch (Exception e) {
            call.reject("Android 알림 설정을 열 수 없습니다.", e);
        }
    }
}
