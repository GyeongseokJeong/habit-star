package __PACKAGE__;

import android.appwidget.AppWidgetManager;
import android.content.Context;
import android.content.Intent;
import android.view.View;
import android.widget.RemoteViews;
import android.widget.RemoteViewsService;
import org.json.JSONObject;
import java.util.ArrayList;
import java.util.List;

/** Both variants share the guarded practice handle; disabled capability is read-only. */
public class ByeolharuWidgetListService extends RemoteViewsService {
    @Override public RemoteViewsFactory onGetViewFactory(Intent intent) {
        final int id=intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,AppWidgetManager.INVALID_APPWIDGET_ID);
        final Context c=getApplicationContext();
        final String requested=intent.getStringExtra("renderTheme");
        final String theme=("system".equals(requested)||"dark".equals(requested)||"light".equals(requested))?requested:ByeolharuWidgetProvider.renderTheme(c,id);
        final boolean showIcons=intent.getBooleanExtra("showIcons",ByeolharuWidgetProvider.showHabitIcons(c,id));
        return new RemoteViewsFactory() {
            List<JSONObject> rows=new ArrayList<>();
            boolean sparse=false;
            public void onCreate(){}
            public void onDataSetChanged(){
                rows=ByeolharuWidgetProvider.rows(c,id,ByeolharuWidgetProvider.read(c),
                    ByeolharuWidgetProvider.options(c).getBoolean(id+":hide",false));
                int height=AppWidgetManager.getInstance(c).getAppWidgetOptions(id)
                    .getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT,0);
                sparse=ByeolharuWidgetProvider.sparseRows(height,rows.size());
            }
            public void onDestroy(){rows.clear();}
            public int getCount(){return ByeolharuWidgetProvider.configured(c,id)?rows.size():0;}
            public RemoteViews getViewAt(int position){
                if(!ByeolharuWidgetProvider.configured(c,id)||position<0||position>=rows.size())return null;
                JSONObject row=rows.get(position);boolean completed=row.optBoolean("completed");
                boolean directPractice=ByeolharuWidgetProvider.directPracticeEnabled(c);
                int layout=directPractice
                    ?(sparse?R.layout.byeolharu_widget_row_action_sparse:R.layout.byeolharu_widget_row_action)
                    :(sparse?R.layout.byeolharu_widget_row_sparse:R.layout.byeolharu_widget_row);
                RemoteViews v=new RemoteViews(c.getPackageName(),layout);
                // Explicitly restore VISIBLE as rows can be recycled by the host.
                v.setViewVisibility(R.id.widget_icon,showIcons?View.VISIBLE:View.GONE);
                v.setTextViewText(R.id.widget_icon,showIcons?row.optString("icon"):"");
                v.setTextViewText(R.id.widget_title,row.optString("title"));
                ByeolharuWidgetProvider.textColor(v,R.id.widget_title,theme,completed?"#716B79":"#302D38",completed?"#A4AABD":"#F0EDF5");
                ByeolharuWidgetProvider.checkIcon(c,v,R.id.widget_check,theme,completed);
                String key=row.optString("actionKey");
                boolean actionable=directPractice&&ByeolharuWidgetProvider.validKey(key);
                String description=actionable?(completed?"실천 완료 취소":"실천 완료하기"):
                    (directPractice?"세부 기록은 앱에서 수정":"실천 "+(completed?"완료":"전"));
                v.setContentDescription(R.id.widget_check,description);
                if(directPractice) {
                    Intent tap=actionable?new Intent().putExtra("actionKey",key):new Intent().putExtra("editInApp",true);
                    v.setOnClickFillInIntent(R.id.widget_row,tap);
                    v.setOnClickFillInIntent(R.id.widget_icon,tap);
                    v.setOnClickFillInIntent(R.id.widget_title,tap);
                    v.setOnClickFillInIntent(R.id.widget_check,tap);
                }
                return v;
            }
            public RemoteViews getLoadingView(){return null;}
            public int getViewTypeCount(){return 4;}
            public long getItemId(int position){return position;}
            public boolean hasStableIds(){return false;}
        };
    }
}
