package __PACKAGE__;

import android.appwidget.AppWidgetManager;
import android.content.Context;
import android.content.Intent;
import android.graphics.Color;
import android.widget.RemoteViews;
import android.widget.RemoteViewsService;
import org.json.JSONObject;
import java.util.ArrayList;
import java.util.List;

/** Read-only list; direct write actions deliberately not bound in STEP 2A/B. */
public class ByeolharuWidgetListService extends RemoteViewsService {
    @Override public RemoteViewsFactory onGetViewFactory(Intent intent) {
        final int id=intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,AppWidgetManager.INVALID_APPWIDGET_ID);
        final Context c=getApplicationContext();
        return new RemoteViewsFactory() {
            List<JSONObject> rows=new ArrayList<>();
            public void onCreate(){}
            public void onDataSetChanged(){
                rows=ByeolharuWidgetProvider.rows(c,id,ByeolharuWidgetProvider.read(c),
                    ByeolharuWidgetProvider.options(c).getBoolean(id+":hide",false));
            }
            public void onDestroy(){rows.clear();}
            public int getCount(){return rows.size();}
            public RemoteViews getViewAt(int position){
                if(position<0||position>=rows.size())return null;
                JSONObject row=rows.get(position);boolean completed=row.optBoolean("completed"),dark=ByeolharuWidgetProvider.dark(c,id);
                RemoteViews v=new RemoteViews(c.getPackageName(),R.layout.byeolharu_widget_row);
                v.setTextViewText(R.id.widget_icon,row.optString("icon"));
                v.setTextViewText(R.id.widget_title,row.optString("title"));
                v.setTextViewText(R.id.widget_check,completed?"✓":"○");
                v.setTextColor(R.id.widget_title,Color.parseColor(completed?(dark?"#A4AABD":"#716B79"):(dark?"#F0EDF5":"#302D38")));
                v.setTextColor(R.id.widget_check,Color.parseColor(completed?(dark?"#87AC92":"#426E52"):(dark?"#A4AABD":"#716B79")));
                v.setContentDescription(R.id.widget_check,completed?"실천 완료":"실천 전");
                return v;
            }
            public RemoteViews getLoadingView(){return null;}
            public int getViewTypeCount(){return 1;}
            public long getItemId(int position){return position;}
            public boolean hasStableIds(){return false;}
        };
    }
}
