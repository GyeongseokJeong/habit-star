/** Request-local STEP 4B-2 adapter, never an exported component or JS interface.
 * Uses the pinned LocalNotifications 8.3.1 manager and its own storage. A
 * PendingIntent probe is only evidence of token existence, NOT alarm delivery.
 * Native alarm and preference updates are not an atomic transaction. */
final class ByeolharuColdReminder {
    private static final String KIND="byeolharu-habit-reminder-v1";
    private static final String CHANNEL="byeolharu-habit-reminders-step5";
    private static final String TITLE="별하루 ✦ ";
    private static final String BODY="오늘의 작은 실천을 떠올려 볼까요?";
    private static final long MARGIN=2000L;
    private static final int MAX_BOOKED=48, MAX_STORED=512, MAX_BYTES=512*1024;
    private static final Set<String> ZONES=new HashSet<>(Arrays.asList(TimeZone.getAvailableIDs()));
    private final Context context;
    private final BooleanSupplier allowed;
    private final long deadline, elapsedDeadline;
    private final NotificationStorage storage;
    private final LocalNotificationManager manager;
    private Target target;
    private Inventory prepared;
    private boolean prepareUsed, applyUsed;
    // Fixed, low-cardinality reason codes only. Never include raw notification
    // JSON, identifiers, titles, exception messages or authentication data.
    private String diagnostic="not-run";
    String diagnosticReason(){return diagnostic;}
    private boolean result(String reason,boolean appCheck){diagnostic=reason;return appCheck;}

    ByeolharuColdReminder(Context context, long deadline, long elapsedDeadline, BooleanSupplier allowed) {
        this.context=context;
        this.deadline=deadline;
        this.elapsedDeadline=elapsedDeadline;
        this.allowed=allowed;
        storage=new NotificationStorage(context);
        manager=new LocalNotificationManager(storage,null,context,CapConfig.loadDefault(context));
    }

    private boolean canAct() {
        return Looper.myLooper()==Looper.getMainLooper() && ByeolharuWidgetProvider.experimental(context)
            && ByeolharuWidgetColdPractice.reminderProcessExclusive()
            && System.currentTimeMillis()<deadline && SystemClock.elapsedRealtime()<elapsedDeadline
            && allowed.getAsBoolean();
    }

    private static String format(long time, String pattern, TimeZone zone) {
        SimpleDateFormat sdf=new SimpleDateFormat(pattern,Locale.US);
        sdf.setTimeZone(zone);
        return sdf.format(new Date(time));
    }
    // Mirror the planner's String.trim() boundary, without altering the
    // stored title or accepting a fingerprint for a non-canonical title.
    private static boolean trimSpace(char c) {
        return (c>=9&&c<=13)||c==32||c==0x00a0||c==0x1680||(c>=0x2000&&c<=0x200a)||
            c==0x2028||c==0x2029||c==0x202f||c==0x205f||c==0x3000||c==0xfeff;
    }
    // Canonical scheduling uses the earlier instant in a repeated wall
    // minute. Independently reject a later-fold stored payload, even when
    // its fingerprint was recomputed with that later instant.
    private static boolean firstWallMinute(long time,TimeZone zone) {
        long wall=time+zone.getOffset(time);
        for(long hours:new long[]{-36,-12,0,12,36}) {
            int offset=zone.getOffset(wall+hours*3600000L);
            long previous=wall-offset;
            if(previous<time&&zone.getOffset(previous)==offset)return false;
        }
        return true;
    }
    private static String text(JSONObject j,String key) {
        Object value=j.opt(key);
        if(!(value instanceof String))throw new IllegalArgumentException();
        return (String)value;
    }
    private static boolean only(JSONObject j,String... fields) {
        Set<String> keys=new HashSet<>(Arrays.asList(fields));
        for(Iterator<String> it=j.keys();it.hasNext();)if(!keys.contains(it.next()))return false;
        return true;
    }
    private static int id(JSONObject j) {
        Object value=j.opt("id");
        if(!(value instanceof Number))throw new IllegalArgumentException();
        double n=((Number)value).doubleValue();
        if(n<1 || n>Integer.MAX_VALUE || n!=(int)n)throw new IllegalArgumentException();
        return (int)n;
    }

    private static final class Target {
        final String scope,habit,day,deviceZone;
        final TimeZone zone;
        final boolean completed;
        final int id;
        Target(JSONObject j) {
            if(!only(j,"scope","habitId","day","timeZone","completed"))throw new IllegalArgumentException();
            scope=text(j,"scope"); habit=text(j,"habitId"); day=text(j,"day");
            String tz=text(j,"timeZone");
            if(!scope.matches("guest|member:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}") ||
                habit.trim().isEmpty() || habit.length()>256 || !day.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}") ||
                !ZONES.contains(tz) || !(j.opt("completed") instanceof Boolean))throw new IllegalArgumentException();
            zone=TimeZone.getTimeZone(tz); deviceZone=TimeZone.getDefault().getID();
            if("guest".equals(scope) && !zone.hasSameRules(TimeZone.getDefault()))throw new IllegalArgumentException();
            completed=j.optBoolean("completed");
            id=ByeolharuColdReminderKey.id(scope,habit,day);
        }
        boolean current(long now) {
            TimeZone device=TimeZone.getDefault();
            return deviceZone.equals(device.getID()) && day.equals(format(now,"yyyy-MM-dd",zone)) &&
                (!"guest".equals(scope)||zone.getOffset(now)==device.getOffset(now));
        }
        boolean owner(JSONObject j) {
            JSONObject e=j.optJSONObject("extra");
            return e!=null && KIND.equals(e.opt("kind")) && scope.equals(e.opt("scope")) &&
                "habit".equals(e.opt("category")) && habit.equals(e.opt("habitId")) && day.equals(e.opt("day"));
        }
    }

    // Read only the same PendingIntent identity and flags used by the pinned
    // manager's cancelTimerForNotification. Never create or cancel it here.
    private boolean tokenExists(int id) {
        int flags=PendingIntent.FLAG_NO_CREATE;
        if(Build.VERSION.SDK_INT>=Build.VERSION_CODES.S)flags|=PendingIntent.FLAG_MUTABLE;
        return PendingIntent.getBroadcast(context,id,new Intent(context,TimedNotificationPublisher.class),flags)!=null;
    }
    private boolean visible(int id) { return manager.currentlyVisibleIds().contains(id); }

    private static final class Inventory {
        final Map<Integer,String> rows=new TreeMap<>();
        final Set<Integer> scheduled=new TreeSet<>(),visible=new TreeSet<>();
        boolean permission,exact,channelReady,token;
        long wall,elapsed;
        boolean same(Inventory other) {
            return rows.equals(other.rows)&&scheduled.equals(other.scheduled)&&visible.equals(other.visible)&&
                permission==other.permission&&exact==other.exact&&channelReady==other.channelReady&&token==other.token&&
                Math.abs((other.wall-wall)-(other.elapsed-elapsed))<1000L;
        }
        boolean sameExceptTarget(Inventory other,int id) {
            Map<Integer,String> a=new TreeMap<>(rows),b=new TreeMap<>(other.rows);
            a.remove(id);b.remove(id);
            Set<Integer> c=new TreeSet<>(scheduled),d=new TreeSet<>(other.scheduled);
            c.remove(id);d.remove(id);
            return a.equals(b)&&c.equals(d)&&visible.equals(other.visible)&&
                permission==other.permission&&exact==other.exact&&channelReady==other.channelReady&&
                Math.abs((other.wall-wall)-(other.elapsed-elapsed))<1000L;
        }
        JSObject forPlanner(Target target) throws Exception {
            JSObject result=new JSObject();
            JSONObject queue=new JSONObject();
            JSONArray saved=new JSONArray();
            for(Map.Entry<Integer,String> row:rows.entrySet()) {
                JSONObject value=new JSONObject(row.getValue());
                // Only the intended habit's canonical fields can cross into
                // the offline renderer; other IDs are collision sentinels.
                if(row.getKey()==target.id && canonical(target,value)!=null) saved.put(value);
                else saved.put(new JSONObject().put("id",row.getKey()));
            }
            queue.put("storedIds",new JSONArray(rows.keySet()));
            queue.put("scheduledIds",new JSONArray(scheduled));
            queue.put("visibleIds",new JSONArray(visible));
            queue.put("saved",saved);
            result.put("permissionGranted",permission&&channelReady);
            result.put("exact",exact);
            result.put("queue",queue);
            return result;
        }
    }
    // Cancellation is a one-ID operation; a full inventory is only needed
    // for restore (capacity and unrelated-reservation protection). Stored
    // IDs come from a SharedPreferences map, so each key is unique. A present
    // but corrupt target must still be decoded and rejected, never treated
    // as an absent reservation.
    private static List<String> inventoryKeys(List<String> keys,int targetId,boolean completed) {
        if(!completed)return keys;
        String key=Integer.toString(targetId);
        return keys.contains(key)?Collections.singletonList(key):Collections.emptyList();
    }
    private Inventory capture() throws Exception {
        if(!canAct()||!target.current(System.currentTimeMillis()))throw new IllegalStateException();
        Inventory q=new Inventory();
        q.wall=System.currentTimeMillis();q.elapsed=SystemClock.elapsedRealtime();
        q.permission=manager.areNotificationsEnabled() &&
            (Build.VERSION.SDK_INT<33 || context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)==PackageManager.PERMISSION_GRANTED);
        AlarmManager alarms=(AlarmManager)context.getSystemService(Context.ALARM_SERVICE);
        q.exact=Build.VERSION.SDK_INT<31 || (alarms!=null&&alarms.canScheduleExactAlarms());
        NotificationManager notifications=(NotificationManager)context.getSystemService(Context.NOTIFICATION_SERVICE);
        if(notifications==null||alarms==null)throw new IllegalStateException();
        q.channelReady=true;
        if(Build.VERSION.SDK_INT>=26) {
            NotificationChannel channel=notifications.getNotificationChannel(CHANNEL);
            q.channelReady=channel!=null && channel.getImportance()!=NotificationManager.IMPORTANCE_NONE;
        }
        List<String> keys=inventoryKeys(storage.getSavedNotificationIds(),target.id,target.completed);
        if(keys.size()>MAX_STORED)throw new IllegalStateException();
        long bytes=0;
        for(String key:keys) {
            if(!canAct())throw new IllegalStateException();
            int k=Integer.parseInt(key);
            if(k<=0||!Integer.toString(k).equals(key)||q.rows.containsKey(k))throw new IllegalArgumentException();
            JSObject raw=storage.getSavedNotificationAsJSObject(key);
            if(raw==null||id(raw)!=k)throw new IllegalArgumentException();
            String json=raw.toString();
            bytes+=2L*json.length();
            if(bytes>MAX_BYTES)throw new IllegalStateException();
            LocalNotification parsed=LocalNotification.Companion.buildNotificationFromJSObject(raw);
            if(parsed.getId()==null || parsed.getId()!=k)throw new IllegalArgumentException();
            q.rows.put(k,json);
            if(manager.isCurrentlyScheduled(parsed))q.scheduled.add(k);
        }
        Set<Integer> visible=manager.currentlyVisibleIds();
        if(target.completed) {
            if(visible.contains(target.id))q.visible.add(target.id);
        } else q.visible.addAll(visible);
        if(q.visible.size()>MAX_STORED || q.visible.stream().anyMatch(k->k<=0))throw new IllegalArgumentException();
        q.token=tokenExists(target.id);
        if(!canAct() || !target.current(System.currentTimeMillis()))throw new IllegalStateException();
        return q;
    }

    /** Reject non-canonical payloads even if the supplied fingerprint matches.
     * The exact canonical title/time fingerprint is recomputed from the
     * existing planner policy; repeating/other options cannot pass through. */
    private static LocalNotification canonical(Target t,JSONObject j) {
        try {
            if(id(j)!=t.id || !t.owner(j) ||
                !only(j,"id","title","body","schedule","isExactNotification","channelId","extra","cancelled") ||
                (j.has("cancelled")&&!Boolean.FALSE.equals(j.opt("cancelled"))) ||
                !CHANNEL.equals(j.opt("channelId")) || !BODY.equals(j.opt("body")) ||
                !(j.opt("isExactNotification") instanceof Boolean))return null;
            String title=text(j,"title");
            if(!title.startsWith(TITLE)||title.length()<=TITLE.length()||title.length()>8192)return null;
            String habitTitle=title.substring(TITLE.length());
            if(trimSpace(habitTitle.charAt(0))||trimSpace(habitTitle.charAt(habitTitle.length()-1)))return null;
            JSONObject s=j.getJSONObject("schedule"),e=j.getJSONObject("extra");
            if(!only(s,"at","allowWhileIdle","repeats") || !Boolean.TRUE.equals(s.opt("allowWhileIdle")) ||
                (s.has("repeats")&&!Boolean.FALSE.equals(s.opt("repeats"))) ||
                !only(e,"kind","scope","habitId","category","day","fingerprint"))return null;
            String at=text(s,"at");
            if(!at.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z"))return null;
            LocalNotification n=LocalNotification.Companion.buildNotificationFromJSObject(new JSObject(j.toString()));
            if(n.getSchedule()==null || n.getSchedule().getAt()==null || n.getSchedule().isPerpetual() ||
                !n.getSchedule().allowWhileIdle() || n.getCancelled() || n.getId()==null || n.getId()!=t.id)return null;
            long time=n.getSchedule().getAt().getTime();
            if(!at.equals(format(time,"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",TimeZone.getTimeZone("UTC"))) ||
                !t.day.equals(format(time,"yyyy-MM-dd",t.zone)) ||
                !"00.000".equals(format(time,"ss.SSS",t.zone)) || !firstWallMinute(time,t.zone))return null;
            String fingerprint=ByeolharuColdReminderKey.fingerprint(t.scope,t.habit,t.day,habitTitle,
                format(time,"HH:mm",t.zone),time,n.isExactNotification());
            if(!fingerprint.equals(e.opt("fingerprint")))return null;
            return n;
        } catch(Exception failure) {return null;}
    }
    private static boolean sameCanonical(Target t,JSONObject a,JSONObject b) {
        LocalNotification x=canonical(t,a),y=canonical(t,b);
        return x!=null&&y!=null&&a.opt("title").equals(b.opt("title"))&&
            x.isExactNotification()==y.isExactNotification()&&
            x.getSchedule().getAt().equals(y.getSchedule().getAt())&&
            a.optJSONObject("extra").opt("fingerprint").equals(b.optJSONObject("extra").opt("fingerprint"));
    }

    JSObject prepare(JSONObject request) {
        if(prepareUsed){diagnostic="prepare-reused";return null;}
        prepareUsed=true;
        if(!canAct()){
            String process=ByeolharuWidgetColdPractice.reminderProcessState();
            diagnostic=ByeolharuWidgetBridgeLease.WORKER_UNKNOWN.equals(process)?"prepare-worker-unknown":
                ByeolharuWidgetBridgeLease.WORKER_DRAINING.equals(process)?"prepare-worker-draining":"prepare-guard-blocked";
            return null;
        }
        try{target=new Target(request);}
        catch(Exception failure){diagnostic="prepare-invalid-target";return null;}
        try{
            prepared=capture();
            JSObject inventory=prepared.forPlanner(target);
            diagnostic="prepared";
            return inventory;
        }catch(Exception failure){prepared=null;diagnostic="prepare-inventory-invalid";return null;}
    }

    /** Return true only for a meaningful reconciliation failure (not an
     * expected policy skip). The persisted habit result is independent. */
    boolean needsAppCheck(JSONObject decision) {
        if(applyUsed)return result("decision-reused",true);
        applyUsed=true;
        if(decision==null)return result("decision-missing",true);
        String kind=decision.optString("kind"),reason=decision.optString("reason");
        if("noop".equals(kind)&&"opted-out-or-unconfigured".equals(reason))return result("policy-opt-out",false);
        if("noop".equals(kind)&&"no-future-target".equals(reason))return result("no-future-target",false);
        if("defer".equals(kind)) {
            if("outside-plan".equals(reason))return result("outside-plan",false);
            // Completion has an identified reservation, but cancellation was
            // too close to its due time to attempt safely. The record is saved;
            // the alarm is still uncertain. Undo simply skips a near-due rebook.
            if("too-close".equals(reason))return result("too-close",target!=null&&target.completed);
            if("permission-unconfirmed".equals(reason))return result("permission-unconfirmed",
                prepared==null||(prepared.permission&&prepared.channelReady));
            // Keep the native prepare failure, when available, rather than
            // replacing it with the generic renderer transport result.
            if("transport-unavailable".equals(reason)&&prepareUsed&&prepared==null)return true;
            if("transport-unavailable".equals(reason))return result("transport-unavailable",true);
            if("stale-commit".equals(reason))return result("stale-commit",true);
            if("preferences-changed".equals(reason))return result("preferences-changed",true);
            if("unknown-preferences".equals(reason))return result("unknown-preferences",true);
            if("occupied-id".equals(reason))return result("occupied-id",true);
            if("visible-id".equals(reason))return result("visible-id",true);
            if("capacity".equals(reason))return result("capacity",true);
            return result("decision-deferred",true);
        }
        try{
            if(prepared==null||!canAct())return result("apply-guard-blocked",true);
            Inventory current=capture();
            if(!prepared.same(current))return result("inventory-changed",true);
            if(!current.permission||!current.channelReady)return result("permission-unconfirmed",true);
            if(current.visible.contains(target.id))return result("visible-id",true);
            String old=current.rows.get(target.id);
            if("noop".equals(kind)) {
                if("already-absent".equals(reason)){
                    boolean unproven=!target.completed||old!=null||current.token;
                    return result(unproven?"absence-unproven":"absence-verified",unproven);
                }
                if("already-scheduled".equals(reason)){
                    boolean unproven=target.completed||old==null||!current.token||
                        !current.scheduled.contains(target.id)||canonical(target,new JSONObject(old))==null;
                    return result(unproven?"schedule-unproven":"schedule-verified",unproven);
                }
                return result("invalid-decision",true);
            }
            boolean cancel="cancel".equals(kind),restore="restore".equals(kind);
            if((!cancel&&!restore)||cancel!=target.completed)return result("invalid-decision",true);
            JSONObject payload=decision.optJSONObject(cancel?"expected":"notification");
            if(payload==null)return result("invalid-decision",true);
            LocalNotification n=canonical(target,payload);
            if(n==null)return result("canonical-invalid",true);
            if(!withinTime(n))return result("time-guard",true);
            if(cancel) {
                // The stored row may have the previous title/time. It must
                // nevertheless be the same owned canonical one-shot supplied
                // by this request and still have a matching native token.
                if(old==null||!current.scheduled.contains(target.id)||!sameCanonical(target,new JSONObject(old),payload))
                    return result("owner-mismatch",true);
                if(!current.token)return result("token-missing",true);
                if(!readyToMutate(current,n)||!tokenExists(target.id))return result("mutation-guard",true);
                SingleCall call=cancelOne(target.id);
                Inventory after=capture();
                boolean unproven=!call.resolved||call.rejected||after.rows.containsKey(target.id)||
                    after.token||after.visible.contains(target.id)||!current.sameExceptTarget(after,target.id)||!canAct();
                return result(unproven?"cancel-unverified":"cancel-verified",unproven);
            }
            if(old!=null||current.token||current.scheduled.size()>=MAX_BOOKED||n.isExactNotification()!=current.exact)
                return result("restore-blocked",true);
            if(!readyToMutate(current,n)||tokenExists(target.id))return result("mutation-guard",true);
            try{
                SingleCall call=new SingleCall("schedule",new JSObject());
                JSONArray ids=manager.schedule(call,Collections.singletonList(n));
                if(call.rejected||ids==null||ids.length()!=1||ids.getInt(0)!=target.id)throw new IllegalStateException();
                storage.appendNotifications(Collections.singletonList(n));
                JSObject saved=storage.getSavedNotificationAsJSObject(Integer.toString(target.id));
                Inventory after=capture();
                if(saved==null||!sameCanonical(target,saved,payload)||!after.token||after.visible.contains(target.id)||
                    !current.sameExceptTarget(after,target.id)||!after.scheduled.contains(target.id)||!withinTime(n))
                    throw new IllegalStateException();
                return result("restore-verified",false);
            }catch(Exception failure){
                // Only clean up a token created during this request, if still
                // owned/not visible and the original claim remains valid.
                // A hard process death between OS schedule and store append
                // is not recoverable atomically; never replay the habit write.
                compensate(payload,n);
                return result("restore-unverified",true);
            }
        }catch(Exception failure){return result("native-error",true);}
    }
    private boolean readyToMutate(Inventory expected,LocalNotification n) {
        if(!canAct()||!withinTime(n)||visible(target.id)||!manager.areNotificationsEnabled())return false;
        if(Build.VERSION.SDK_INT>=33 && context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)!=PackageManager.PERMISSION_GRANTED)return false;
        AlarmManager alarms=(AlarmManager)context.getSystemService(Context.ALARM_SERVICE);
        if(alarms==null||expected.exact!=(Build.VERSION.SDK_INT<31||alarms.canScheduleExactAlarms()))return false;
        if(Build.VERSION.SDK_INT>=26) {
            NotificationManager manager=(NotificationManager)context.getSystemService(Context.NOTIFICATION_SERVICE);
            NotificationChannel channel=manager==null?null:manager.getNotificationChannel(CHANNEL);
            if(channel==null||channel.getImportance()==NotificationManager.IMPORTANCE_NONE)return false;
        }
        return canAct()&&withinTime(n);
    }
    private boolean withinTime(LocalNotification n) {
        long now=System.currentTimeMillis();
        long at=n.getSchedule().getAt().getTime();
        return target.current(now)&&at>now+MARGIN&&
            (!"guest".equals(target.scope)||target.zone.getOffset(at)==TimeZone.getDefault().getOffset(at));
    }
    private void compensate(JSONObject intended,LocalNotification n) {
        try{
            if(!canAct()||!withinTime(n)||visible(target.id))return;
            JSObject existing=storage.getSavedNotificationAsJSObject(Integer.toString(target.id));
            if((existing==null&&!storage.getSavedNotificationIds().contains(Integer.toString(target.id)))||
                (existing!=null&&sameCanonical(target,existing,intended)))cancelOne(target.id);
        }catch(Exception ignored){/* uncertain; foreground reconciliation only */}
    }
    private SingleCall cancelOne(int id) throws Exception {
        JSObject options=new JSObject();
        options.put("notifications",new JSONArray().put(new JSONObject().put("id",id)));
        SingleCall call=new SingleCall("cancel",options);
        manager.cancel(call);
        return call;
    }
    /** PluginCall normally resolves to an Activity bridge. Capture completion
     * locally; a rejection dominates even if manager subsequently resolves. */
    private static final class SingleCall extends PluginCall {
        boolean resolved,rejected;
        SingleCall(String method,JSObject data){super(null,"LocalNotifications","cold-widget",method,data);}
        @Override public void resolve(){resolved=true;}
        @Override public void resolve(JSObject data){resolved=true;}
        @Override public void reject(String msg,String code,Exception ex,JSObject data){rejected=true;}
    }
}
