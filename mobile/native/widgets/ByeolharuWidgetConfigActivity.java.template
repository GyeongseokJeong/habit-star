package __PACKAGE__;

import android.app.Activity;
import android.appwidget.AppWidgetManager;
import android.content.Intent;
import android.os.Bundle;
import android.view.ViewGroup;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.Spinner;
import android.widget.TextView;

/** Launcher configuration: explicit consent before displaying titles. */
public class ByeolharuWidgetConfigActivity extends Activity {
    private int dp(int n){return Math.round(n*getResources().getDisplayMetrics().density);}
    private void label(LinearLayout root,String value,int size){
        TextView t=new TextView(this);t.setText(value);t.setTextSize(size);t.setPadding(0,dp(12),0,dp(6));root.addView(t);
    }
    private Spinner choices(LinearLayout root,String[] values,int selected){
        Spinner s=new Spinner(this);ArrayAdapter<String> a=new ArrayAdapter<>(this,android.R.layout.simple_spinner_dropdown_item,values);
        s.setAdapter(a);s.setSelection(selected);s.setMinimumHeight(dp(48));root.addView(s);return s;
    }
    private int index(String[] list,String value){for(int i=0;i<list.length;i++)if(list[i].equals(value))return i;return 0;}
    @Override protected void onCreate(Bundle saved){
        super.onCreate(saved);
        int id=getIntent().getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,AppWidgetManager.INVALID_APPWIDGET_ID);
        Intent result=new Intent().putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,id);setResult(RESULT_CANCELED,result);
        if(!ByeolharuWidgetProvider.owns(this,id)){finish();return;}
        LinearLayout root=new LinearLayout(this);root.setOrientation(LinearLayout.VERTICAL);root.setPadding(dp(24),dp(24),dp(24),dp(24));
        ScrollView scroll=new ScrollView(this);scroll.addView(root);setContentView(scroll);
        label(root,"별하루 위젯 설정",22);
        label(root,"표시할 습관",16);
        String[] filters={"auto","all","morning","day","night"}, themes={"system","light","dark"};
        android.content.SharedPreferences prefs=ByeolharuWidgetProvider.options(this);
        Spinner filter=choices(root,new String[]{"현재 시간대 자동 전환","전체 습관","아침","낮","저녁"},index(filters,prefs.getString(id+":filter","auto")));
        CheckBox hide=new CheckBox(this);hide.setText("완료한 습관 숨기기");hide.setChecked(prefs.getBoolean(id+":hide",false));hide.setMinHeight(dp(48));root.addView(hide);
        label(root,"화면 테마",16);
        Spinner theme=choices(root,new String[]{"시스템","라이트","다크"},index(themes,prefs.getString(id+":theme","system")));
        label(root,"습관 이름과 완료 상태가 홈 화면에 표시됩니다. 초기 버전에서는 앱에서 기록해 주세요.",14);
        CheckBox consent=new CheckBox(this);consent.setText("홈 화면에 습관을 표시합니다");consent.setChecked(prefs.getBoolean(id+":consent",false));consent.setMinHeight(dp(48));root.addView(consent);
        Button save=new Button(this);save.setText("적용하기");save.setEnabled(consent.isChecked());save.setMinHeight(dp(48));root.addView(save);
        consent.setOnCheckedChangeListener((b,checked)->save.setEnabled(checked));
        save.setOnClickListener(v->{
            if(!ByeolharuWidgetProvider.owns(this,id)||!consent.isChecked())return;
            if(!prefs.edit().putBoolean(id+":consent",true).putString(id+":filter",filters[filter.getSelectedItemPosition()])
                .putBoolean(id+":hide",hide.isChecked()).putString(id+":theme",themes[theme.getSelectedItemPosition()]).commit())return;
            ByeolharuWidgetProvider.refreshAll(this);setResult(RESULT_OK,result);finish();
        });
    }
}
