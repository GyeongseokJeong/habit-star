package __PACKAGE__;

import android.app.Activity;
import android.appwidget.AppWidgetManager;
import android.content.Intent;
import android.content.res.ColorStateList;
import android.content.res.Configuration;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.Bundle;
import android.view.Gravity;
import android.view.View;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.LinearLayout;
import android.widget.RadioButton;
import android.widget.RadioGroup;
import android.widget.ScrollView;
import android.widget.Switch;
import android.widget.TextView;
import android.widget.ImageView;

/** Configuration is a draft until Apply; preview uses synthetic habits only. */
public class ByeolharuWidgetConfigActivity extends Activity {
    private static final String[] FILTERS={"auto","all","morning","day","night"};
    private static final String[] THEMES={"system","light","dark"};
    private static final String[] LABELS={"시간대 자동","전체","아침","낮","저녁"};
    private boolean night;
    private int filterIndex,themeIndex;
    private LinearLayout preview;
    private Switch hide;
    private CheckBox consent;
    private Button save;
    private int dp(int n){return Math.round(n*getResources().getDisplayMetrics().density);}
    private int color(String s){return Color.parseColor(s);}
    private int ink(){return color(night?"#F0EDF5":"#302D38");}
    private int muted(){return color(night?"#A4AABD":"#716B79");}
    private int accent(){return color(night?"#E5C78D":"#92703B");}
    private int surface(){return color(night?"#252C3D":"#FFFCF7");}
    private GradientDrawable shape(int fill,int stroke,int radius){
        GradientDrawable d=new GradientDrawable();d.setColor(fill);d.setCornerRadius(dp(radius));
        if(stroke!=0)d.setStroke(dp(1),stroke);return d;
    }
    private TextView text(String value,int size,int tint,boolean bold){
        TextView t=new TextView(this);t.setText(value);t.setTextSize(size);t.setTextColor(tint);
        if(bold)t.setTypeface(Typeface.DEFAULT,Typeface.BOLD);return t;
    }
    private LinearLayout column(){LinearLayout l=new LinearLayout(this);l.setOrientation(LinearLayout.VERTICAL);return l;}
    private void space(LinearLayout l,int n){View v=new View(this);l.addView(v,new LinearLayout.LayoutParams(1,dp(n)));}
    private void section(LinearLayout root,String title){space(root,20);root.addView(text(title,14,ink(),true));space(root,8);}
    private int index(String[] list,String value){for(int i=0;i<list.length;i++)if(list[i].equals(value))return i;return 0;}
    private ColorStateList controlTint(){return new ColorStateList(new int[][]{new int[]{android.R.attr.state_checked},new int[]{}},new int[]{accent(),muted()});}
    private RadioGroup choices(LinearLayout root,String[] labels,int selected,boolean horizontal,java.util.function.IntConsumer change){
        RadioGroup group=new RadioGroup(this);group.setOrientation(horizontal?LinearLayout.HORIZONTAL:LinearLayout.VERTICAL);
        for(int i=0;i<labels.length;i++){
            RadioButton b=new RadioButton(this);b.setId(View.generateViewId());b.setText(labels[i]);b.setTextColor(ink());b.setTextSize(14);
            b.setButtonTintList(controlTint());b.setMinHeight(dp(48));b.setPadding(dp(8),dp(4),dp(4),dp(4));
            b.setBackground(shape(surface(),color(night?"#41495B":"#E2D9CC"),12));
            RadioGroup.LayoutParams lp=new RadioGroup.LayoutParams(horizontal?0:-1,-2,horizontal?1:0);
            lp.setMargins(0,0,dp(horizontal&&i<labels.length-1?6:0),dp(horizontal?0:6));group.addView(b,lp);
        }
        group.check(group.getChildAt(selected).getId());
        group.setOnCheckedChangeListener((g,id)->{for(int i=0;i<g.getChildCount();i++)if(g.getChildAt(i).getId()==id){change.accept(i);break;}});
        root.addView(group);return group;
    }
    private void refreshPreview(){
        if(preview==null||hide==null||consent==null)return;
        boolean dark=themeIndex==2||(themeIndex==0&&night);
        int fg=color(dark?"#F0EDF5":"#302D38"),sub=color(dark?"#A4AABD":"#716B79"),gold=color(dark?"#E5C78D":"#92703B");
        preview.removeAllViews();preview.setBackground(shape(color(dark?"#1C2233":"#FFFCF7"),color(dark?"#41495B":"#E2D9CC"),18));
        LinearLayout header=new LinearLayout(this);header.setGravity(Gravity.CENTER_VERTICAL);
        String title=filterIndex==0?"자동":filterIndex==1?"오늘":LABELS[filterIndex];
        header.addView(text("✦ "+title,14,gold,true),new LinearLayout.LayoutParams(0,dp(36),1));
        header.addView(text(consent.isChecked()?"1/3":"—",14,gold,true));preview.addView(header);
        if(!consent.isChecked()){preview.addView(text("습관 표시 꺼짐",13,sub,false));return;}
        String[] names={"💪  운동하기","📚  독서 30분","🌙  일찍 잠들기"};
        for(int i=0;i<names.length;i++){
            if(i==0&&hide.isChecked())continue;
            LinearLayout row=new LinearLayout(this);row.setGravity(Gravity.CENTER_VERTICAL);
            TextView name=text(names[i],13,i==0?sub:fg,false);name.setSingleLine(true);name.setEllipsize(android.text.TextUtils.TruncateAt.END);
            row.addView(name,new LinearLayout.LayoutParams(0,dp(48),1));name.setGravity(Gravity.CENTER_VERTICAL);
            ImageView icon=new ImageView(this);icon.setScaleType(ImageView.ScaleType.CENTER);
            icon.setImageResource(i==0?(dark?R.drawable.byeolharu_widget_check_dark:R.drawable.byeolharu_widget_check_light):(dark?R.drawable.byeolharu_widget_circle_dark:R.drawable.byeolharu_widget_circle_light));
            icon.setContentDescription(i==0?"실천 완료":"실천 전");row.addView(icon,new LinearLayout.LayoutParams(dp(28),dp(48)));preview.addView(row);
        }
    }
    @Override protected void onSaveInstanceState(Bundle out){
        super.onSaveInstanceState(out);if(hide==null||consent==null)return;
        out.putInt("filter",filterIndex);out.putInt("theme",themeIndex);out.putBoolean("hide",hide.isChecked());out.putBoolean("consent",consent.isChecked());
    }
    @Override protected void onCreate(Bundle saved){
        super.onCreate(saved);
        int id=getIntent().getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,AppWidgetManager.INVALID_APPWIDGET_ID);
        Intent result=new Intent().putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,id);setResult(RESULT_CANCELED,result);
        if(!ByeolharuWidgetProvider.owns(this,id)){finish();return;}
        night=(getResources().getConfiguration().uiMode&Configuration.UI_MODE_NIGHT_MASK)==Configuration.UI_MODE_NIGHT_YES;
        int bg=color(night?"#171D29":"#F6F2EC");
        // Dark navigation icons are supported only from API 26. Keep the
        // light-mode status bar, but preserve white-icon contrast below 26.
        boolean lightNavigation=!night&&android.os.Build.VERSION.SDK_INT>=26;
        getWindow().setStatusBarColor(bg);
        getWindow().setNavigationBarColor(lightNavigation?bg:color("#171D29"));
        int flags=night?0:View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
        if(lightNavigation)flags|=View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;
        getWindow().getDecorView().setSystemUiVisibility(flags);
        android.content.SharedPreferences prefs=ByeolharuWidgetProvider.options(this);
        final boolean existing=prefs.contains(id+":consent");
        filterIndex=saved==null?index(FILTERS,prefs.getString(id+":filter","auto")):saved.getInt("filter");
        themeIndex=saved==null?index(THEMES,prefs.getString(id+":theme","system")):saved.getInt("theme");
        LinearLayout root=column();root.setPadding(dp(20),dp(16),dp(20),dp(24));root.setBackgroundColor(bg);
        ScrollView scroll=new ScrollView(this);scroll.setFillViewport(true);scroll.setBackgroundColor(bg);scroll.addView(root);setContentView(scroll);
        LinearLayout bar=new LinearLayout(this);bar.setGravity(Gravity.CENTER_VERTICAL);
        Button back=new Button(this);back.setText("‹");back.setTextSize(24);back.setTextColor(ink());back.setContentDescription("뒤로가기");back.setBackgroundColor(Color.TRANSPARENT);back.setOnClickListener(v->finish());
        bar.addView(back,new LinearLayout.LayoutParams(dp(48),dp(48)));bar.addView(text("위젯 설정",22,ink(),true));root.addView(bar);
        space(root,12);preview=column();preview.setPadding(dp(10),dp(6),dp(10),dp(10));
        LinearLayout.LayoutParams pp=new LinearLayout.LayoutParams(dp(176),-2);pp.gravity=Gravity.CENTER_HORIZONTAL;root.addView(preview,pp);
        TextView caption=text("미리보기 · 예시 습관",12,muted(),false);caption.setGravity(Gravity.CENTER);root.addView(caption);
        section(root,"표시할 습관");
        // Two direct-choice groups share one logical filter; native radio semantics.
        RadioGroup first=choices(root,new String[]{LABELS[0],LABELS[1]},Math.min(filterIndex,1),true,i->{});
        RadioGroup second=choices(root,new String[]{LABELS[2],LABELS[3],LABELS[4]},Math.max(0,filterIndex-2),true,i->{});
        if(filterIndex<2)second.clearCheck();else first.clearCheck();
        first.setOnCheckedChangeListener((g,selected)->{if(selected==-1)return;second.clearCheck();filterIndex=g.indexOfChild(g.findViewById(selected));refreshPreview();});
        second.setOnCheckedChangeListener((g,selected)->{if(selected==-1)return;first.clearCheck();filterIndex=2+g.indexOfChild(g.findViewById(selected));refreshPreview();});
        space(root,12);hide=new Switch(this);hide.setText("완료한 습관 숨기기");hide.setTextColor(ink());hide.setTextSize(14);hide.setMinHeight(dp(48));hide.setPadding(dp(12),0,dp(12),0);hide.setBackground(shape(surface(),0,12));hide.setThumbTintList(controlTint());hide.setTrackTintList(ColorStateList.valueOf(color(night?"#596171":"#C8BFB3")));hide.setChecked(saved==null?prefs.getBoolean(id+":hide",false):saved.getBoolean("hide"));root.addView(hide);
        section(root,"화면 테마");choices(root,new String[]{"시스템","라이트","다크"},themeIndex,true,i->{themeIndex=i;refreshPreview();});
        space(root,20);LinearLayout privacy=column();privacy.setPadding(dp(12),dp(8),dp(12),dp(12));privacy.setBackground(shape(surface(),0,12));root.addView(privacy);
        consent=new CheckBox(this);consent.setText("홈 화면에 습관 표시");consent.setTextColor(ink());consent.setButtonTintList(controlTint());consent.setMinHeight(dp(48));consent.setChecked(saved==null?prefs.getBoolean(id+":consent",false):saved.getBoolean("consent"));privacy.addView(consent);
        privacy.addView(text("습관 이름과 완료 상태가 홈 화면에 표시됩니다.",13,muted(),false));
        space(privacy,6);privacy.addView(text(ByeolharuWidgetProvider.experimental(this)?"테스트 버전: 앱이 백그라운드에 있을 때 체크할 수 있어요.":"기록은 앱에서 할 수 있어요.",12,muted(),false));
        space(root,20);save=new Button(this);save.setText("적용하기");save.setAllCaps(false);save.setTextSize(16);save.setMinHeight(dp(52));save.setTextColor(color(night?"#302D38":"#FFFFFF"));save.setBackground(shape(accent(),0,14));root.addView(save,new LinearLayout.LayoutParams(-1,-2));
        save.setEnabled(existing || consent.isChecked());save.setAlpha(save.isEnabled()?1f:0.45f);
        consent.setOnCheckedChangeListener((b,checked)->{save.setEnabled(existing || checked);save.setAlpha(save.isEnabled()?1f:0.45f);refreshPreview();});
        hide.setOnCheckedChangeListener((b,checked)->refreshPreview());
        save.setOnClickListener(v->{
            if(!ByeolharuWidgetProvider.owns(this,id)||(!existing && !consent.isChecked()))return;
            if(!ByeolharuWidgetProvider.saveOptions(this,id,consent.isChecked(),FILTERS[filterIndex],hide.isChecked(),THEMES[themeIndex]))return;
            setResult(RESULT_OK,result);finish();
        });
        refreshPreview();
    }
}
