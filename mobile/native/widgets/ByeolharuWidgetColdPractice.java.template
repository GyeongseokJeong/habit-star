package __PACKAGE__;

import android.content.Context;
import android.os.Handler;
import android.os.Looper;
import android.os.SystemClock;
import android.util.Log;
import android.webkit.JavascriptInterface;
import android.webkit.RenderProcessGoneDetail;
import android.webkit.WebResourceRequest;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import com.getcapacitor.JSObject;
import org.json.JSONObject;
import org.json.JSONTokener;
import java.io.InputStream;
import java.util.Scanner;

/** Debug-only detached, same-origin runtime. The bridge exposes only a
 * request-bound permission check; the result poll owns the one-shot alarm
 * preparation/application and exposes no general native write methods. */
final class ByeolharuWidgetColdPractice {
    private static final String ORIGIN="https://localhost/";
    private static final String TAG="ByeolharuWidget";
    private static final ByeolharuWidgetBridgeLease BRIDGES=new ByeolharuWidgetBridgeLease();
    static ByeolharuWidgetBridgeLease.Lease activityStarted(){return BRIDGES.started();}
    static void workerCaptured(ByeolharuWidgetBridgeLease.Lease lease,Thread worker){BRIDGES.workerCaptured(lease,worker);}
    static void activityStopped(ByeolharuWidgetBridgeLease.Lease lease){BRIDGES.destroyed(lease);}
    static boolean hasActivity(){return BRIDGES.hasActivity()||ByeolharuDeviceSettingsPlugin.hasWidgetActivity();}
    static String reminderProcessState(){
        return ByeolharuDeviceSettingsPlugin.hasWidgetActivity()?ByeolharuWidgetBridgeLease.LIVE_ACTIVITY:BRIDGES.state();
    }
    static boolean reminderProcessExclusive(){
        String state=reminderProcessState();
        return ByeolharuWidgetBridgeLease.NEW_PROCESS.equals(state)||ByeolharuWidgetBridgeLease.DRAINED_PROCESS.equals(state);
    }

    private final Context context;
    private final String requestId,key;
    private final long deadline;
    private final Handler handler=new Handler(Looper.getMainLooper());
    private WebView view;
    private boolean finished,started,prepareSeen;
    private long reminderDeadline,reminderElapsedDeadline,prepareWaitUntil;
    private ByeolharuColdReminder reminders;
    private String alarmDiagnostic="";
    private final Runnable timeout=()->{Log.i(TAG,"cold-alarm result=deadline");finish(null);};
    private final Runnable poll=this::readResult;

    private ByeolharuWidgetColdPractice(Context c,String requestId,String key,long deadline){
        context=c.getApplicationContext();this.requestId=requestId;this.key=key;this.deadline=deadline;
    }
    static void start(Context c,String requestId,String key,long deadline){
        if(!ByeolharuWidgetProvider.experimental(c)||hasActivity()||
            !ByeolharuWidgetProvider.coldAllowed(c,requestId)){
            ByeolharuWidgetProvider.complete(c,requestId,"not-ready");return;
        }
        new ByeolharuWidgetColdPractice(c,requestId,key,deadline).open();
    }
    public final class Gate {
        @JavascriptInterface public boolean allowed(){
            return ByeolharuWidgetProvider.coldAllowed(context,requestId);
        }
    }
    private void open(){
        long remaining=Math.min(6500L,deadline-System.currentTimeMillis()-300L);
        if(remaining<=0){finish(null);return;}
        reminderDeadline=System.currentTimeMillis()+remaining;
        reminderElapsedDeadline=SystemClock.elapsedRealtime()+remaining;
        handler.postDelayed(timeout,remaining);
        try(InputStream input=context.getAssets().open("public/widget-cold-runtime.js");
            Scanner scanner=new Scanner(input,"UTF-8")){
            String script=scanner.useDelimiter("\\A").next();
            view=new WebView(context);
            view.getSettings().setJavaScriptEnabled(true);
            view.getSettings().setDomStorageEnabled(true);
            view.getSettings().setAllowFileAccess(false);
            view.getSettings().setAllowContentAccess(false);
            view.getSettings().setBlockNetworkLoads(true);
            view.addJavascriptInterface(new Gate(),"ByeolharuColdGate");
            view.setWebViewClient(new WebViewClient(){
                @Override public boolean shouldOverrideUrlLoading(WebView v,WebResourceRequest request){return true;}
                @Override public boolean onRenderProcessGone(WebView v,RenderProcessGoneDetail detail){finish(null);return true;}
                @Override public void onPageFinished(WebView v,String url){
                    if(finished||started)return;
                    if(!ORIGIN.equals(url)||!ByeolharuWidgetProvider.coldAllowed(context,requestId)){finish(null);return;}
                    started=true;
                    v.evaluateJavascript(script+"\n;window.__byeolharuColdStart("+JSONObject.quote(key)+","+deadline+","+reminderDeadline+");",ignored->{
                        if(!finished)handler.postDelayed(poll,100L);
                    });
                }
            });
            // Only a trusted empty document and the packaged offline bundle.
            // No remote navigation, network, normal app mount or auth client.
            view.loadDataWithBaseURL(ORIGIN,"<!doctype html><html><head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'\"></head><body></body></html>","text/html","UTF-8",null);
        }catch(RuntimeException | java.io.IOException e){finish(null);}
    }
    // A swipe from Recents can leave a known worker draining briefly.
    // Wait only for that provable transitional state, never for an unknown
    // worker or live Activity. Keep enough of the existing cold deadline
    // for the single prepare/result exchange and the final native check.
    private static boolean mayWaitForWorker(String state,long now,long waitUntil,long deadline){
        return ByeolharuWidgetBridgeLease.WORKER_DRAINING.equals(state) &&
            now<waitUntil && deadline-now>750L;
    }
    private void readResult(){
        if(finished||view==null)return;
        if(!ByeolharuWidgetProvider.coldAllowed(context,requestId)){finish(null);return;}
        try{
            // WebView's V8 conversion of a returned object is not JSON.stringify:
            // a reminder's Date can become epoch seconds instead of the ISO
            // string required by native canonical validation. Serialize inside
            // the renderer and decode the callback's JSON-encoded string once.
            view.evaluateJavascript("JSON.stringify({result:window.__byeolharuColdResult||null,prepare:window.__byeolharuColdPrepare||null})",value->{
                if(finished)return;
                if(!ByeolharuWidgetProvider.coldAllowed(context,requestId)){finish(null);return;}
                try{
                    Object parsed=new JSONTokener(value).nextValue();
                    if(!(parsed instanceof String)){finish(null);return;}
                    JSONObject message=new JSONObject((String)parsed);
                    JSONObject result=message.optJSONObject("result");
                    if(result!=null){
                        boolean saved="saved".equals(result.optString("status"));
                        // In this native cold entry the reminder transport is
                        // always supplied. A saved record without a decision
                        // is not evidence that its alarm was reconciled.
                        boolean alarmCheck=saved;
                        if(saved && result.has("alarm")){
                            JSONObject decision=result.optJSONObject("alarm");
                            // Even a no-op can be decided without a native prepare.
                            // A mutated inventory or invalid claim only defers the
                            // alarm, never the committed habit.
                            try {
                                if(reminders==null) reminders=new ByeolharuColdReminder(context,reminderDeadline,reminderElapsedDeadline,
                                    ()->ByeolharuWidgetProvider.coldAllowed(context,requestId));
                                alarmCheck=reminders.needsAppCheck(decision);
                                alarmDiagnostic=reminders.diagnosticReason();
                                Log.i(TAG,"cold-alarm apply="+alarmDiagnostic);
                            } catch(RuntimeException e){alarmCheck=true;alarmDiagnostic="exception";Log.i(TAG,"cold-alarm apply=exception");}
                        } else if(saved) {alarmDiagnostic="missing-decision";Log.i(TAG,"cold-alarm apply=missing-decision");}
                        result.remove("alarm");
                        result.put("alarmCheckNeeded",alarmCheck);
                        finish(new JSObject(result.toString()));
                        return;
                    }
                    JSONObject prepare=message.optJSONObject("prepare");
                    if(prepare!=null&&!prepareSeen){
                        long now=SystemClock.elapsedRealtime();
                        if(prepareWaitUntil==0L)prepareWaitUntil=now+1000L;
                        if(mayWaitForWorker(reminderProcessState(),now,prepareWaitUntil,reminderElapsedDeadline)){
                            handler.postDelayed(poll,100L);return;
                        }
                        prepareSeen=true;
                        JSObject inventory=null;
                        try {
                            reminders=new ByeolharuColdReminder(context,reminderDeadline,reminderElapsedDeadline,
                                ()->ByeolharuWidgetProvider.coldAllowed(context,requestId));
                            inventory=reminders.prepare(prepare);
                            Log.i(TAG,"cold-alarm prepare="+reminders.diagnosticReason()+" process="+reminderProcessState());
                        }catch(RuntimeException ignored){Log.i(TAG,"cold-alarm prepare=exception process="+reminderProcessState());}
                        String json=inventory==null?"null":inventory.toString();
                        // Quote the entire response; habit text is never JS source.
                        if(view!=null)view.evaluateJavascript("window.__byeolharuColdPrepared&&window.__byeolharuColdPrepared("+JSONObject.quote(json)+")",ignored->{});
                    }
                    handler.postDelayed(poll,150L);
                }catch(Exception e){finish(null);}
            });
        }catch(RuntimeException e){finish(null);}
    }
    private void finish(JSObject result){
        if(finished)return;finished=true;
        handler.removeCallbacks(timeout);handler.removeCallbacks(poll);
        reminders=null;
        WebView old=view;view=null;
        if(old!=null){try{old.removeJavascriptInterface("ByeolharuColdGate");old.destroy();}catch(RuntimeException ignored){}}
        if(result!=null)ByeolharuWidgetProvider.completeCold(context,requestId,result,alarmDiagnostic);
        else ByeolharuWidgetProvider.complete(context,requestId,"not-ready");
    }
}
