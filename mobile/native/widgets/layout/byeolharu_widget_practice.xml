<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/byeolharu_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦ 별하루 · 오늘의 실천" android:textSize="14sp" android:textColor="#F3D393" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="23sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="앱에서 기록을 불러와요" android:textSize="11sp" android:textColor="#D8D3E6" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/widget_morning" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="아침 —" android:textSize="12sp" android:textColor="#F3D393" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_day" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="낮 —" android:textSize="12sp" android:textColor="#F3D393" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_night" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="밤 —" android:textSize="12sp" android:textColor="#F3D393" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="남은 습관 · 앱 열기" android:textSize="10sp" android:textColor="#D8D3E6" android:maxLines="1"/>
</LinearLayout>
