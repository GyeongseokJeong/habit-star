package __PACKAGE__;

import android.app.AlarmManager;
import android.app.PendingIntent;
import android.appwidget.AppWidgetManager;
import android.appwidget.AppWidgetProvider;
import android.appwidget.AppWidgetProviderInfo;
import android.content.ComponentName;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.content.res.Configuration;
import android.graphics.Color;
import android.net.Uri;
import android.util.AtomicFile;
import android.view.View;
import android.widget.RemoteViews;
import com.getcapacitor.JSObject;
import org.json.JSONArray;
import org.json.JSONObject;
import java.io.File;
import java.io.FileOutputStream;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Calendar;
import java.util.List;
import java.util.TimeZone;

/** Read-only, opt-in projection. Never writes habit data. */
public abstract class ByeolharuWidgetProvider extends AppWidgetProvider {
    static final String EXPIRE = "byeolharu.widget.REFRESH";
    static final long MAX_TTL = 36L * 3600000L;
    public static class Mini extends ByeolharuWidgetProvider {}
    public static class Compact extends ByeolharuWidgetProvider {}
    static SharedPreferences options(Context c) { return c.getSharedPreferences("byeolharu_widget_options_v2", Context.MODE_PRIVATE); }
    static AtomicFile cache(Context c) { return new AtomicFile(new File(c.getNoBackupFilesDir(), "byeolharu_widget_display_v2.json")); }
    static boolean owns(Context c, int id) {
        AppWidgetProviderInfo info = AppWidgetManager.getInstance(c).getAppWidgetInfo(id);
        if (info == null || info.provider == null) return false;
        return info.provider.equals(new ComponentName(c, Mini.class)) || info.provider.equals(new ComponentName(c, Compact.class));
    }
    static boolean configured(Context c, int id) { return owns(c,id) && options(c).getBoolean(id+":consent", false); }
    static int[] ids(Context c, Class<?> type) { return AppWidgetManager.getInstance(c).getAppWidgetIds(new ComponentName(c,type)); }
    static boolean anyConfigured(Context c) {
        for (Class<?> type : new Class<?>[]{Mini.class, Compact.class})
            for (int id : ids(c,type)) if (configured(c,id)) return true;
        return false;
    }
    // Serialize consent changes with publication so a queued snapshot cannot
    // recreate the display cache after the last opt-in is withdrawn.
    static synchronized boolean saveOptions(Context c,int id,boolean consent,String filter,boolean hide,String theme) {
        if (!owns(c,id)) return false;
        if (!options(c).edit().putBoolean(id+":consent",consent).putString(id+":filter",filter)
            .putBoolean(id+":hide",hide).putString(id+":theme",theme).commit()) return false;
        refreshAll(c);
        return true;
    }
    static synchronized void clear(Context c) { cache(c).delete(); }
    static synchronized JSONObject read(Context c) {
        if (!anyConfigured(c)) { clear(c); return null; }
        try {
            JSONObject data = new JSONObject(new String(cache(c).readFully(), StandardCharsets.UTF_8));
            long expiry = data.optLong("expiresAt"), now = System.currentTimeMillis();
            if (expiry > now && expiry - now <= MAX_TTL) return data;
            clear(c);
        } catch (Exception ignored) {}
        return null;
    }
    static synchronized void publish(Context c, JSObject data) throws Exception {
        long expiry = data.optLong("expiresAt"), now = System.currentTimeMillis();
        clear(c);
        JSONArray incoming = data.optJSONArray("rows");
        if (anyConfigured(c) && data.optBoolean("ready") && incoming != null && expiry > now && expiry - now <= MAX_TTL) {
            JSONArray rows = new JSONArray();
            for (int i=0; i<incoming.length(); i++) {
                JSONObject row = incoming.optJSONObject(i);
                if (row == null) continue;
                String group = row.optString("group");
                if (!group.equals("morning") && !group.equals("day") && !group.equals("night")) continue;
                // Store only allowed display fields; titles may be visible on the home screen.
                rows.put(new JSONObject().put("title",row.optString("title")).put("icon",row.optString("icon"))
                    .put("group",group).put("completed",row.optBoolean("completed")));
            }
            JSONObject projected = new JSONObject().put("expiresAt",expiry).put("timezone",data.optString("timezone")).put("rows",rows);
            AtomicFile file = cache(c);
            FileOutputStream out = file.startWrite();
            try { out.write(projected.toString().getBytes(StandardCharsets.UTF_8)); file.finishWrite(out); }
            catch (Exception e) { file.failWrite(out); throw e; }
        }
        refreshAll(c);
    }
    static String group(JSONObject data) {
        Calendar time = Calendar.getInstance(zone(data));
        int hour = time.get(Calendar.HOUR_OF_DAY);
        return hour >= 5 && hour < 11 ? "morning" : hour >= 11 && hour < 17 ? "day" : "night";
    }
    static TimeZone zone(JSONObject data) { return data == null ? TimeZone.getDefault() : TimeZone.getTimeZone(data.optString("timezone",TimeZone.getDefault().getID())); }
    static String filter(Context c,int id,JSONObject data) {
        String value=options(c).getString(id+":filter","auto");
        return "auto".equals(value) ? group(data) : value;
    }
    static boolean dark(Context c,int id) {
        String theme=options(c).getString(id+":theme","system");
        return "dark".equals(theme) || ("system".equals(theme) &&
          (c.getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES);
    }
    static List<JSONObject> rows(Context c,int id,JSONObject data,boolean hide) {
        List<JSONObject> list=new ArrayList<>();
        if (!configured(c,id) || data==null) return list;
        String filter=filter(c,id,data);
        JSONArray rows=data.optJSONArray("rows");
        if (rows==null) return list;
        for(int i=0;i<rows.length();i++){
            JSONObject row=rows.optJSONObject(i);
            if(row!=null && ("all".equals(filter)||filter.equals(row.optString("group"))) &&
                (!hide || !row.optBoolean("completed"))) list.add(row);
        }
        return list;
    }
    static String label(String group) {
        switch(group){case "morning":return "아침";case "day":return "낮";case "night":return "저녁";default:return "오늘";}
    }
    static void schedule(Context c, JSONObject data) {
        AlarmManager alarm=(AlarmManager)c.getSystemService(Context.ALARM_SERVICE);
        if(alarm==null)return;
        PendingIntent pi=PendingIntent.getBroadcast(c,8101,new Intent(c,Mini.class).setAction(EXPIRE),
            PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE);
        try {
            alarm.cancel(pi);
            if(data==null||!anyConfigured(c))return;
            Calendar current=Calendar.getInstance(zone(data));
            long next=data.optLong("expiresAt");
            for(int hour:new int[]{5,11,17}){
                Calendar boundary=(Calendar)current.clone();
                boundary.set(Calendar.HOUR_OF_DAY,hour);boundary.set(Calendar.MINUTE,0);
                boundary.set(Calendar.SECOND,0);boundary.set(Calendar.MILLISECOND,0);
                if(boundary.after(current))next=Math.min(next,boundary.getTimeInMillis());
            }
            alarm.set(AlarmManager.RTC,next,pi);
        }catch(RuntimeException ignored){}
    }
    static synchronized void refreshAll(Context c) {
        JSONObject data=read(c);
        for(Class<?> type:new Class<?>[]{Mini.class,Compact.class})
            for(int id:ids(c,type))render(c,id,data);
        schedule(c,data);
    }
    @Override public void onUpdate(Context c,AppWidgetManager m,int[] ids) { refreshAll(c); }
    @Override public void onDeleted(Context c,int[] ids) {
        synchronized (ByeolharuWidgetProvider.class) {
            SharedPreferences.Editor e=options(c).edit();
            for(int id:ids)for(String k:new String[]{":consent",":filter",":hide",":theme"})e.remove(id+k);
            e.commit();
            refreshAll(c);
        }
    }
    @Override public void onReceive(Context c,Intent intent){
        super.onReceive(c,intent);
        String a=intent.getAction();
        if(Intent.ACTION_TIME_CHANGED.equals(a)||Intent.ACTION_TIMEZONE_CHANGED.equals(a)){clear(c);refreshAll(c);}
        else if(EXPIRE.equals(a)||Intent.ACTION_DATE_CHANGED.equals(a))refreshAll(c);
    }
    static void render(Context c,int id,JSONObject data) {
        if(!owns(c,id))return;
        boolean dark=dark(c,id), consent=configured(c,id), ready=consent&&data!=null;
        RemoteViews v=new RemoteViews(c.getPackageName(),dark?R.layout.byeolharu_widget_dark:R.layout.byeolharu_widget_light);
        List<JSONObject> all=rows(c,id,data,false);
        int done=0;for(JSONObject row:all)if(row.optBoolean("completed"))done++;
        v.setTextViewText(R.id.widget_label,label(filter(c,id,data)));
        v.setTextViewText(R.id.widget_count,ready?done+"/"+all.size():"—");
        v.setTextViewText(R.id.widget_empty,all.isEmpty()?"예정된 습관이 없어요":"모든 실천을 마쳤어요");
        // Hide the entire collection container even if the launcher still has
        // cached RemoteViews rows. The separate placeholder cannot be toggled
        // by ListView's asynchronous empty-view handling.
        v.setViewVisibility(R.id.widget_content,ready?View.VISIBLE:View.GONE);
        v.setViewVisibility(R.id.widget_private,ready?View.GONE:View.VISIBLE);
        v.setTextViewText(R.id.widget_private,consent?"앱에서 기록 불러오기":"습관 표시 꺼짐");
        Intent open=new Intent(c,MainActivity.class).setAction(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_SINGLE_TOP|Intent.FLAG_ACTIVITY_CLEAR_TOP);
        v.setOnClickPendingIntent(R.id.widget_header,PendingIntent.getActivity(c,8102,open,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE));
        v.setOnClickPendingIntent(R.id.widget_empty,PendingIntent.getActivity(c,8102,open,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE));
        v.setOnClickPendingIntent(R.id.widget_private,PendingIntent.getActivity(c,8102,open,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE));
        Intent service=new Intent(c,ByeolharuWidgetListService.class).putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,id)
            .setData(Uri.parse("byeolharu-widget://list/"+id+"/"+(dark?"dark":"light")+"/"+(ready?"visible":"hidden")));
        v.setRemoteAdapter(R.id.widget_list,service);
        v.setEmptyView(R.id.widget_list,R.id.widget_empty);
        AppWidgetManager manager=AppWidgetManager.getInstance(c);
        manager.updateAppWidget(id,v);
        manager.notifyAppWidgetViewDataChanged(id,R.id.widget_list);
    }
}
