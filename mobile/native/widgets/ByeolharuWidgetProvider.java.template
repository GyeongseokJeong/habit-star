package __PACKAGE__;

import android.app.AlarmManager;
import android.app.PendingIntent;
import android.appwidget.AppWidgetManager;
import android.appwidget.AppWidgetProvider;
import android.appwidget.AppWidgetProviderInfo;
import android.content.ComponentName;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.content.res.Configuration;
import android.content.res.ColorStateList;
import android.graphics.drawable.Icon;
import android.content.pm.ApplicationInfo;
import android.content.pm.PackageManager;
import android.os.Bundle;
import android.os.Build;
import android.os.Handler;
import android.os.Looper;
import android.widget.Toast;
import java.util.UUID;
import android.graphics.Color;
import android.net.Uri;
import android.util.AtomicFile;
import android.view.View;
import android.widget.RemoteViews;
import com.getcapacitor.JSObject;
import org.json.JSONArray;
import org.json.JSONObject;
import java.io.File;
import java.io.FileOutputStream;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Calendar;
import java.util.List;
import java.util.TimeZone;

/** Read-only, opt-in projection. Never writes habit data. */
public abstract class ByeolharuWidgetProvider extends AppWidgetProvider {
    static final String EXPIRE = "byeolharu.widget.REFRESH";
    static final String PRACTICE = "byeolharu.widget.PRACTICE";
    static final long REQUEST_TTL = 8000L;
    static boolean debuggable(Context c) { return (c.getApplicationInfo().flags & ApplicationInfo.FLAG_DEBUGGABLE) != 0; }
    private static Boolean releaseCandidate;
    // Loaded once from immutable compiled application metadata. Do not use
    // preferences, widget extras or WebView input to enable direct practice.
    static synchronized boolean directPracticeEnabled(Context c) {
        if(debuggable(c)) return true;
        if(!"app.byeolharu.android".equals(c.getPackageName())) return false;
        if(releaseCandidate==null) {
            try {
                Bundle meta=c.getPackageManager().getApplicationInfo(c.getPackageName(),PackageManager.GET_META_DATA).metaData;
                releaseCandidate=meta!=null && Boolean.TRUE.equals(meta.get("app.byeolharu.widget.RELEASE_CANDIDATE"));
            } catch(PackageManager.NameNotFoundException | RuntimeException ignored) { releaseCandidate=false; }
        }
        return releaseCandidate;
    }
    static boolean validKey(String value) { return value != null && value.matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"); }
    private static final Handler MAIN = new Handler(Looper.getMainLooper());
    private static PracticeRequest pending;
    private static class PracticeRequest {
        final String requestId = UUID.randomUUID().toString();
        final String key; final int widget; final long deadline; final PendingResult broadcast;
        boolean claimed;
        PracticeRequest(String key,int widget,PendingResult broadcast) {
            this.key=key; this.widget=widget; this.broadcast=broadcast; deadline=System.currentTimeMillis()+REQUEST_TTL;
        }
    }
    static final long MAX_TTL = 36L * 3600000L;
    public static class Mini extends ByeolharuWidgetProvider {}
    public static class Compact extends ByeolharuWidgetProvider {}
    static SharedPreferences options(Context c) { return c.getSharedPreferences("byeolharu_widget_options_v2", Context.MODE_PRIVATE); }
    static AtomicFile cache(Context c) { return new AtomicFile(new File(c.getNoBackupFilesDir(), "byeolharu_widget_display_v2.json")); }
    static boolean owns(Context c, int id) {
        AppWidgetProviderInfo info = AppWidgetManager.getInstance(c).getAppWidgetInfo(id);
        if (info == null || info.provider == null) return false;
        return info.provider.equals(new ComponentName(c, Mini.class)) || info.provider.equals(new ComponentName(c, Compact.class));
    }
    static boolean configured(Context c, int id) { return owns(c,id) && options(c).getBoolean(id+":consent", false); }
    static int[] ids(Context c, Class<?> type) { return AppWidgetManager.getInstance(c).getAppWidgetIds(new ComponentName(c,type)); }
    static boolean anyConfigured(Context c) {
        for (Class<?> type : new Class<?>[]{Mini.class, Compact.class})
            for (int id : ids(c,type)) if (configured(c,id)) return true;
        return false;
    }
    // Serialize consent changes with publication so a queued snapshot cannot
    // recreate the display cache after the last opt-in is withdrawn.
    static boolean showHabitIcons(Context c,int id) { return options(c).getBoolean(id+":showIcons",true); }
    static synchronized boolean saveOptions(Context c,int id,boolean consent,String filter,boolean hide,String theme,boolean showIcons) {
        if (!owns(c,id)) return false;
        if (!options(c).edit().putBoolean(id+":consent",consent).putString(id+":filter",filter)
            .putBoolean(id+":hide",hide).putString(id+":theme",theme).putBoolean(id+":showIcons",showIcons).commit()) return false;
        refreshAll(c);
        return true;
    }
    static synchronized void clear(Context c) { cache(c).delete(); }
    static synchronized JSONObject read(Context c) {
        if (!anyConfigured(c)) { clear(c); return null; }
        try {
            JSONObject data = new JSONObject(new String(cache(c).readFully(), StandardCharsets.UTF_8));
            long expiry = data.optLong("expiresAt"), now = System.currentTimeMillis();
            if (expiry > now && expiry - now <= MAX_TTL) return data;
            clear(c);
        } catch (Exception ignored) {}
        return null;
    }
    static synchronized void publish(Context c, JSObject data) throws Exception {
        long expiry = data.optLong("expiresAt"), now = System.currentTimeMillis();
        clear(c);
        JSONArray incoming = data.optJSONArray("rows");
        if (anyConfigured(c) && data.optBoolean("ready") && incoming != null && expiry > now && expiry - now <= MAX_TTL) {
            JSONArray rows = new JSONArray();
            for (int i=0; i<incoming.length(); i++) {
                JSONObject row = incoming.optJSONObject(i);
                if (row == null) continue;
                String group = row.optString("group");
                if (!group.equals("morning") && !group.equals("day") && !group.equals("night")) continue;
                // Store only allowed display fields; titles may be visible on the home screen.
                JSONObject projectedRow = new JSONObject().put("title",row.optString("title")).put("icon",row.optString("icon"))
                    .put("group",group).put("completed",row.optBoolean("completed"));
                String key=row.optString("actionKey");
                if(directPracticeEnabled(c)&&validKey(key)) projectedRow.put("actionKey",key);
                rows.put(projectedRow);
            }
            JSONObject projected = new JSONObject().put("expiresAt",expiry).put("timezone",data.optString("timezone")).put("rows",rows);
            AtomicFile file = cache(c);
            FileOutputStream out = file.startWrite();
            try { out.write(projected.toString().getBytes(StandardCharsets.UTF_8)); file.finishWrite(out); }
            catch (Exception e) { file.failWrite(out); throw e; }
        }
        refreshAll(c);
    }
    static String group(JSONObject data) {
        Calendar time = Calendar.getInstance(zone(data));
        int hour = time.get(Calendar.HOUR_OF_DAY);
        return hour >= 5 && hour < 11 ? "morning" : hour >= 11 && hour < 17 ? "day" : "night";
    }
    static TimeZone zone(JSONObject data) { return data == null ? TimeZone.getDefault() : TimeZone.getTimeZone(data.optString("timezone",TimeZone.getDefault().getID())); }
    static String filter(Context c,int id,JSONObject data) {
        String value=options(c).getString(id+":filter","auto");
        return "auto".equals(value) ? group(data) : value;
    }
    static boolean dark(Context c,int id) {
        String theme=options(c).getString(id+":theme","system");
        return "dark".equals(theme) || ("system".equals(theme) &&
          (c.getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES);
    }
    // A render chooses one theme for its entire RemoteViews tree.
    // API 31+ resolves both alternatives inside the launcher on re-apply;
    // older hosts receive a concrete theme, including in their row adapter URI.
    static String renderTheme(Context c,int id) {
        String theme=options(c).getString(id+":theme","system");
        return "system".equals(theme)&&Build.VERSION.SDK_INT>=31?"system":dark(c,id)?"dark":"light";
    }
    // A fixed preference supplies identical values for both host configurations.
    // Always emit the same property actions so reapply cannot retain an old tint.
    static <T> T themeValue(String theme,boolean night,T light,T dark) {
        return ("dark".equals(theme)||("system".equals(theme)&&night))?dark:light;
    }
    static void textColor(RemoteViews v,int id,String theme,String light,String dark) {
        if (Build.VERSION.SDK_INT>=31)
            v.setColorInt(id,"setTextColor",Color.parseColor(themeValue(theme,false,light,dark)),
                Color.parseColor(themeValue(theme,true,light,dark)));
        else v.setTextColor(id,Color.parseColor(themeValue(theme,false,light,dark)));
    }
    static void homeIcon(Context c,RemoteViews v,String theme) {
        int light=R.drawable.byeolharu_widget_home_light,dark=R.drawable.byeolharu_widget_home_dark;
        if(Build.VERSION.SDK_INT>=31)
            v.setIcon(R.id.widget_home,"setImageIcon",Icon.createWithResource(c,themeValue(theme,false,light,dark)),
                Icon.createWithResource(c,themeValue(theme,true,light,dark)));
        else v.setImageViewResource(R.id.widget_home,themeValue(theme,false,light,dark));
    }
    static boolean sparseRows(int minHeight,int count) {
        return count>=1 && count<=2 && minHeight>=60+count*60;
    }
    static void checkIcon(Context c,RemoteViews v,int id,String theme,boolean completed) {
        int light=completed?R.drawable.byeolharu_widget_check_light:R.drawable.byeolharu_widget_circle_light;
        int dark=completed?R.drawable.byeolharu_widget_check_dark:R.drawable.byeolharu_widget_circle_dark;
        if (Build.VERSION.SDK_INT>=31)
            v.setIcon(id,"setImageIcon",Icon.createWithResource(c,themeValue(theme,false,light,dark)),
                Icon.createWithResource(c,themeValue(theme,true,light,dark)));
        else v.setImageViewResource(id,themeValue(theme,false,light,dark));
    }
    static List<JSONObject> rows(Context c,int id,JSONObject data,boolean hide) {
        List<JSONObject> list=new ArrayList<>();
        if (!configured(c,id) || data==null) return list;
        String filter=filter(c,id,data);
        JSONArray rows=data.optJSONArray("rows");
        if (rows==null) return list;
        for(int i=0;i<rows.length();i++){
            JSONObject row=rows.optJSONObject(i);
            if(row!=null && ("all".equals(filter)||filter.equals(row.optString("group"))) &&
                (!hide || !row.optBoolean("completed"))) list.add(row);
        }
        return list;
    }
    static String label(String group) {
        switch(group){case "morning":return "아침";case "day":return "낮";case "night":return "저녁";default:return "오늘";}
    }
    static void schedule(Context c, JSONObject data) {
        AlarmManager alarm=(AlarmManager)c.getSystemService(Context.ALARM_SERVICE);
        if(alarm==null)return;
        PendingIntent pi=PendingIntent.getBroadcast(c,8101,new Intent(c,Mini.class).setAction(EXPIRE),
            PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE);
        try {
            alarm.cancel(pi);
            if(data==null||!anyConfigured(c))return;
            Calendar current=Calendar.getInstance(zone(data));
            long next=data.optLong("expiresAt");
            for(int hour:new int[]{5,11,17}){
                Calendar boundary=(Calendar)current.clone();
                boundary.set(Calendar.HOUR_OF_DAY,hour);boundary.set(Calendar.MINUTE,0);
                boundary.set(Calendar.SECOND,0);boundary.set(Calendar.MILLISECOND,0);
                if(boundary.after(current))next=Math.min(next,boundary.getTimeInMillis());
            }
            alarm.set(AlarmManager.RTC,next,pi);
        }catch(RuntimeException ignored){}
    }
    static synchronized void refreshAll(Context c) {
        JSONObject data=read(c);
        for(Class<?> type:new Class<?>[]{Mini.class,Compact.class})
            for(int id:ids(c,type))render(c,id,data);
        schedule(c,data);
    }
    @Override public void onUpdate(Context c,AppWidgetManager m,int[] ids) { refreshAll(c); }
    @Override public void onAppWidgetOptionsChanged(Context c,AppWidgetManager m,int id,android.os.Bundle options) {
        super.onAppWidgetOptionsChanged(c,m,id,options);
        // The shared flexible layout uses host-measured width/height. Do not
        // store cell sizes, change preferences, trim rows or rotate action keys.
        // Refresh only the resized instance under the normal projection lock.
        synchronized (ByeolharuWidgetProvider.class) {
            if (owns(c,id)) render(c,id,read(c));
        }
    }
    @Override public void onDeleted(Context c,int[] ids) {
        synchronized (ByeolharuWidgetProvider.class) {
            SharedPreferences.Editor e=options(c).edit();
            for(int id:ids)for(String k:new String[]{":consent",":filter",":hide",":theme",":showIcons"})e.remove(id+k);
            e.commit();
            refreshAll(c);
        }
    }
    @Override public void onReceive(Context c,Intent intent){
        if(PRACTICE.equals(intent.getAction())) {
            // Ignore cached navigation taps from the previous version.
            if(intent.hasExtra("detailKey"))return;
            begin(c,intent,goAsync()); return;
        }
        super.onReceive(c,intent);
        String a=intent.getAction();
        if(Intent.ACTION_TIME_CHANGED.equals(a)||Intent.ACTION_TIMEZONE_CHANGED.equals(a)){clear(c);refreshAll(c);}
        else if(EXPIRE.equals(a)||Intent.ACTION_DATE_CHANGED.equals(a))refreshAll(c);
    }
    private static boolean currentKey(Context c,int id,String key) {
        if(!directPracticeEnabled(c)||!configured(c,id)||!validKey(key))return false;
        for(JSONObject row:rows(c,id,read(c),options(c).getBoolean(id+":hide",false)))
            if(key.equals(row.optString("actionKey")))return true;
        return false;
    }
    private static void message(Context c,String value) {
        MAIN.post(()->Toast.makeText(c.getApplicationContext(),value,Toast.LENGTH_SHORT).show());
    }
    private static synchronized void begin(Context context,Intent intent,PendingResult broadcast) {
        Context c=context.getApplicationContext();
        int id=-1;
        try {
            Uri data=intent.getData();
            if(data!=null && "byeolharu-widget".equals(data.getScheme()) && "practice".equals(data.getHost()))
                id=Integer.parseInt(data.getLastPathSegment());
        } catch(RuntimeException ignored){}
        String key=intent.getStringExtra("actionKey");
        if(intent.getBooleanExtra("editInApp",false)) {
            broadcast.finish();
            if(directPracticeEnabled(c)&&configured(c,id)&&key==null) {
                for(JSONObject row:rows(c,id,read(c),options(c).getBoolean(id+":hide",false))) {
                    if(!validKey(row.optString("actionKey"))) {
                        message(c,"세부 기록은 앱에서 수정할 수 있어요.");break;
                    }
                }
            }
            return;
        }
        if(pending!=null||!currentKey(c,id,key)) {
            broadcast.finish(); message(c,"별하루 앱에서 오늘 기록을 확인해 주세요."); return;
        }
        PracticeRequest request=new PracticeRequest(key,id,broadcast);pending=request;
        JSObject payload=new JSObject();
        payload.put("requestId",request.requestId);payload.put("actionKey",key);payload.put("deadline",request.deadline);
        MAIN.post(()->{
            if(ByeolharuDeviceSettingsPlugin.dispatchWidgetPractice(payload)) return;
            // The detached runtime reconstructs from the existing committed
            // store, never from titles or the native display cache.
            if(!ByeolharuWidgetColdPractice.hasActivity() && claim(c,payload))
                ByeolharuWidgetColdPractice.start(c,request.requestId,key,request.deadline);
            else complete(c,request.requestId,"not-ready");
        });
        MAIN.postDelayed(()->complete(c,request.requestId,"timeout"),REQUEST_TTL);
    }
    static synchronized boolean claim(Context c,JSObject data) {
        PracticeRequest request=pending;
        if(request==null||request.claimed||System.currentTimeMillis()>=request.deadline||
            !request.requestId.equals(data.optString("requestId"))||!request.key.equals(data.optString("actionKey"))||
            !currentKey(c,request.widget,request.key))return false;
        request.claimed=true;return true;
    }
    static synchronized boolean coldAllowed(Context c,String requestId) {
        PracticeRequest request=pending;
        return request!=null && request.claimed && request.requestId.equals(requestId)
            && System.currentTimeMillis()<request.deadline
            && !ByeolharuWidgetColdPractice.hasActivity()
            && currentKey(c,request.widget,request.key);
    }
    static synchronized void completeCold(Context c,String id,JSObject result,String alarmDiagnostic) {
        if(!coldAllowed(c,id)) { complete(c,id,"not-ready");return; }
        String status=result.optString("status");
        if("saved".equals(status)) {
            // Only a committed repository result may publish a new projection.
            boolean alarmCheck=result.optBoolean("alarmCheckNeeded",false);
            JSONObject summary=result.optJSONObject("summary");
            if(summary!=null) {
                try { publish(c,new JSObject(summary.toString()));complete(c,id,alarmCheck?"saved-alarm-check":"saved",alarmDiagnostic);return; }
                catch(Exception ignored){}
            }
            complete(c,id,alarmCheck?"saved-refresh-alarm-check":"saved-refresh-needed",alarmDiagnostic);return;
        }
        complete(c,id,"not-ready");
    }
    static synchronized void complete(Context c,String id,String result) {
        complete(c,id,result,"");
    }
    private static synchronized void complete(Context c,String id,String result,String alarmDiagnostic) {
        PracticeRequest request=pending;
        if(request==null||!request.requestId.equals(id))return;
        pending=null;request.broadcast.finish();
        // Never modify the displayed check state here. Only committed JS
        // snapshot publication can update it, including after a timeout.
        // Debug-only, only on an existing failure toast. A native fixed
        // reason code helps diagnose device reports without collecting logs,
        // account/record identifiers or any raw exception/user content.
        boolean debugDetail=debuggable(c)&&alarmDiagnostic!=null&&alarmDiagnostic.matches("[a-z-]{1,40}");
        if("saved-alarm-check".equals(result)&&request.claimed) {
            message(c,debugDetail?"기록 저장 완료 · 알림 확인 필요\n"+alarmDiagnostic:
                "기록은 저장했어요. 알림은 앱에서 다시 확인해 주세요.");
        } else if("saved-refresh-alarm-check".equals(result)&&request.claimed) {
            message(c,debugDetail?"기록 저장 완료 · 위젯·알림 확인\n"+alarmDiagnostic:
                "기록은 저장했어요. 앱에서 위젯과 알림을 확인해 주세요.");
        } else if("saved-refresh-needed".equals(result)&&request.claimed) {
            message(c,"기록은 저장했어요. 앱에서 위젯을 갱신해 주세요.");
        } else if(!"saved".equals(result)||!request.claimed)
            message(c,"별하루 앱에서 오늘 기록을 확인해 주세요.");
    }
    static void render(Context c,int id,JSONObject data) {
        if(!owns(c,id))return;
        String theme=renderTheme(c,id);
        boolean consent=configured(c,id), ready=consent&&data!=null;
        RemoteViews v=new RemoteViews(c.getPackageName(),"dark".equals(theme)?R.layout.byeolharu_widget_dark:R.layout.byeolharu_widget_light);
        if (Build.VERSION.SDK_INT>=31) {
            // Preserve the rounded shape and explicitly overwrite tint even for
            // fixed Light/Dark: the host may reapply the same layout resource.
            v.setColorStateList(R.id.widget_root,"setBackgroundTintList",
                ColorStateList.valueOf(Color.parseColor(themeValue(theme,false,"#FFFCF7","#1C2233"))),
                ColorStateList.valueOf(Color.parseColor(themeValue(theme,true,"#FFFCF7","#1C2233"))));
        }
        homeIcon(c,v,theme);
        textColor(v,R.id.widget_label,theme,"#302D38","#F0EDF5");
        textColor(v,R.id.widget_count,theme,"#92703B","#E5C78D");
        textColor(v,R.id.widget_empty,theme,"#716B79","#A4AABD");
        textColor(v,R.id.widget_private,theme,"#716B79","#A4AABD");
        List<JSONObject> all=rows(c,id,data,false);
        int done=0;for(JSONObject row:all)if(row.optBoolean("completed"))done++;
        v.setTextViewText(R.id.widget_label,label(filter(c,id,data)));
        v.setTextViewText(R.id.widget_count,ready?done+"/"+all.size():"—");
        v.setTextViewText(R.id.widget_empty,all.isEmpty()?"예정된 습관이 없어요":"모든 실천을 마쳤어요");
        // Hide the entire collection container even if the launcher still has
        // cached RemoteViews rows. The separate placeholder cannot be toggled
        // by ListView's asynchronous empty-view handling.
        v.setViewVisibility(R.id.widget_content,ready?View.VISIBLE:View.GONE);
        v.setViewVisibility(R.id.widget_private,ready?View.GONE:View.VISIBLE);
        v.setTextViewText(R.id.widget_private,consent?"앱에서 기록을 불러와 주세요":"습관 표시 꺼짐");
        Intent open=new Intent(c,MainActivity.class).setAction(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_SINGLE_TOP|Intent.FLAG_ACTIVITY_CLEAR_TOP);
        v.setOnClickPendingIntent(R.id.widget_home,PendingIntent.getActivity(c,8102,open,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE));
        boolean showIcons=showHabitIcons(c,id);
        // Include the display preference in adapter identity: extras alone
        // are not part of Intent.filterEquals in the launcher collection cache.
        Intent service=new Intent(c,ByeolharuWidgetListService.class).putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID,id)
            .putExtra("renderTheme",theme).putExtra("showIcons",showIcons)
            .setData(Uri.parse("byeolharu-widget://list/"+id+"/v12/"+theme+"/"+(ready?"visible":"hidden")+"/"+(showIcons?"icons":"text")));
        v.setRemoteAdapter(R.id.widget_list,service);
        if(directPracticeEnabled(c)&&ready) {
            Intent tap=new Intent(c,Mini.class).setAction(PRACTICE)
                .setData(Uri.parse("byeolharu-widget://practice/"+id));
            int flags=PendingIntent.FLAG_UPDATE_CURRENT;
            if(Build.VERSION.SDK_INT>=31)flags|=PendingIntent.FLAG_MUTABLE;
            // Collection fill-in extras carry only an opaque action handle;
            // the explicit receiver, action and widget URI are fixed here.
            v.setPendingIntentTemplate(R.id.widget_list,PendingIntent.getBroadcast(c,id,tap,flags));
        }
        v.setEmptyView(R.id.widget_list,R.id.widget_empty);
        AppWidgetManager manager=AppWidgetManager.getInstance(c);
        manager.updateAppWidget(id,v);
        manager.notifyAppWidgetViewDataChanged(id,R.id.widget_list);
    }
}
